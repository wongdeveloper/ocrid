PORT=6017

# Optional AI vision extraction. Without this, Python uses local Tesseract OCR.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: use a separate vision model for OCR reads.
OPENAI_OCR_MODEL=gpt-4.1
# Keep OCR accurate while reducing average image/text token usage.
OPENAI_OCR_ADAPTIVE=true
OPENAI_OCR_CONTEXT_CHARS=5000
OPENAI_OCR_FALLBACK_CONTEXT_CHARS=12000
# Fast local OCR hints for AI mode. Increase for more context; lower/disable for speed.
OPENAI_OCR_LOCAL_CONTEXT=true
OPENAI_OCR_LOCAL_CONTEXT_IMAGES=3
OPENAI_OCR_LOCAL_CONTEXT_TIMEOUT_SECONDS=8

# Local OCR fallback language. The app reuses bundled Indonesian/English data.
TESSERACT_LANGUAGE=ind+eng

# Must match the verify token configured in the Meta WhatsApp webhook screen.
WHATSAPP_VERIFY_TOKEN=change-this-local-secret

# Meta WhatsApp Cloud API credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# Optional. If set, POST webhooks must match the x-hub-signature-256 HMAC.
META_APP_SECRET=

# Optional. Default is /webhook.
WHATSAPP_WEBHOOK_PATH=/webhook

# Unofficial QR-authenticated WhatsApp Web worker (runs separately on port 3001).
WHATSAPP_WEB_HOST=127.0.0.1
WHATSAPP_WEB_PORT=3001
WHATSAPP_WEB_CLIENT_ID=ocrid
WHATSAPP_WEB_SESSION_PATH=.wwebjs_auth
WHATSAPP_WEB_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
OCR_API_URL=http://127.0.0.1:6017
WHATSAPP_WEB_ALLOW_GROUPS=false
WHATSAPP_MISSING_ID_MEDIA_DELAY_MS=1200
WHATSAPP_MEDIA_DOWNLOAD_RETRIES=2
WHATSAPP_MEDIA_DOWNLOAD_RETRY_DELAY_MS=900

# Optional for localhost. Required before exposing the worker API to a network.
WHATSAPP_BRIDGE_API_KEY=

# Legacy Node server browser-worker language. Supported values: ind, eng.
OCR_LANGUAGE=ind
