{
  "name": "ocrid",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "start": ".venv/bin/python main.py",
    "start:python": ".venv/bin/python main.py",
    "start:node": "node server.js",
    "start:whatsapp-web": "node whatsapp-web-worker.js",
    "static": "python3 -m http.server 6017",
    "macos:install": "bash scripts/macos-install-launchd.sh",
    "macos:uninstall": "bash scripts/macos-uninstall-launchd.sh",
    "macos:status": "bash scripts/macos-status-launchd.sh",
    "test:python": ".venv/bin/python -m unittest discover -s tests -v",
    "test:whatsapp-web": "node --check whatsapp-web-worker.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ind": "^1.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide": "^1.17.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
